<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/rounded_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Family Bubble"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#9C27B0"
        android:layout_marginBottom="20dp"
        />


    <ImageView
        android:id="@+id/img_selected_profile"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/baseline_account_circle_24"
        android:layout_gravity="center"

        android:background="@drawable/circle_border_purple"/>

    <EditText
        android:id="@+id/et_bubble_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Person Name (e.g. Appa)"
        android:inputType="textPersonName"
        android:layout_marginBottom="10dp"
        android:textColorHint="@color/black"
        android:layout_marginTop="50px"/>

    <EditText
        android:id="@+id/et_bubble_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:inputType="phone"
        android:textColorHint="@color/black"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Icon:"
        android:layout_marginBottom="10dp"
        android:textColor="@color/black"
        android:textColorHint="@color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/icon_appa"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_appa"
            android:layout_gravity="center"
            app:civ_border_width="1dp"
            app:civ_border_color="#FF000000"
            android:layout_marginRight="10px"
            android:layout_marginLeft="10px"
            />
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/icon_amma"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_amma"
            android:layout_gravity="center"
            app:civ_border_width="1dp"
            app:civ_border_color="#FF000000"
            android:layout_marginRight="10px"
            android:layout_marginLeft="10px"
            />
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/icon_frnd"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_appa"
            android:layout_gravity="center"
            app:civ_border_width="1dp"
            app:civ_border_color="#FF000000"
            android:layout_marginRight="10px"
            android:layout_marginLeft="10px"
            />


    </LinearLayout>

    <RadioGroup
        android:id="@+id/rg_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <RadioButton
            android:id="@+id/rb_permanent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permanent"
            android:checked="true"
            android:textColor="@color/black"
            android:textColorHint="@color/black"/>

        <RadioButton
            android:id="@+id/rb_temporary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temporary"
            android:textColor="@color/black"
            android:textColorHint="@color/black"/>
    </RadioGroup>

    <LinearLayout
        android:id="@+id/layout_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/rg_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rb_1hr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Hour" android:textColor="@color/black"
                android:textColorHint="@color/black"/>
            <RadioButton android:id="@+id/rb_6hr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6 Hours" android:textColor="@color/black"
                android:textColorHint="@color/black"/>
        </RadioGroup>
    </LinearLayout>


    <Button
        android:id="@+id/btn_save_bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAVE BUBBLE"
        android:backgroundTint="#9C27B0"
        android:textColor="#FFFFFF"/>

</LinearLayout>