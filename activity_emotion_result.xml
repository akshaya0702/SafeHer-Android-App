<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="20dp">

        <ImageView
            android:id="@+id/img_emotion"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_dialog_info"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tv_fear_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALYZING..."
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_support_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please wait while we analyze."
            android:textAlignment="center"
            android:textSize="18sp"
            android:layout_marginTop="15dp"
            android:textColor="#37474F"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_send_sos"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="YES"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="5dp"
                app:cornerRadius="30dp"/>

            <Button
                android:id="@+id/btn_im_safe"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="NO"
                android:backgroundTint="#CFD8DC"
                android:textColor="#37474F"
                android:layout_marginStart="5dp"
                app:cornerRadius="30dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_cancel_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL ALERT"
            android:layout_marginTop="20dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>
</RelativeLayout>