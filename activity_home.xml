<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFEFE">

    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:paddingTop="28dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#9C27B0">

        <ImageView
            android:id="@+id/img_profile"
            android:layout_width="45dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_profile"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/img_profile"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:text="SAFEHER"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingTop="15dp"
            android:textStyle="bold" />


        <ImageView
            android:id="@+id/img_notification"
            android:layout_width="45dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingTop="15dp"
            android:src="@drawable/outline_notifications_24"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/header_layout"
        android:layout_margin="15dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="4dp">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search Person..."
            android:paddingStart="15dp"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:id="@+id/banner_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_card"
        android:layout_marginHorizontal="15dp"
        app:cardBackgroundColor="#F3E5F5"
        app:cardCornerRadius="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_system_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="🛡️ SHAKE SENSOR"
                android:textColor="#9C27B0"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_shake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:checked="true"
                app:thumbTint="#9C27B0"
                app:trackTint="#D1C4E9" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:id="@+id/camera_window"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_below="@id/banner_status"
        android:layout_margin="15dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Live Camera Detection Feed"
                android:textColor="#FFFFFF" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_gps_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/camera_window"
        android:layout_centerHorizontal="true"
        android:text="📍 GPS Tracking: Enabled"
        android:textColor="#9C27B0"
        android:textStyle="bold" />
    <Button
        android:id="@+id/btn_trigger_bubble"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/camera_window"
        android:layout_margin="20dp"
        android:text="Create a Bubble"
        android:backgroundTint="#9C27B0"
        android:textColor="#FFFFFF" />


    <TextView
        android:id="@+id/tv_privacy_policy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_gps_status"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:text="Privacy Policy &amp; SMS Consent"
        android:textColor="#757575"
        android:textSize="12sp"
        android:padding="10dp"
        android:background="?attr/selectableItemBackground" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_chatbot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="110dp"
        android:layout_marginRight="25dp"
        android:src="@drawable/outline_chat_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@drawable/nav_item_color"
    android:contentDescription="Chatbot" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_outline_home_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@drawable/nav_item_color" />
        <ImageButton
            android:id="@+id/img_face"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/outline_face_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@drawable/nav_item_color" />

        <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_sos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@android:drawable/ic_menu_send"
                app:backgroundTint="#FF1744"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <ImageButton
            android:id="@+id/img_call"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/outline_add_call_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@drawable/nav_item_color" />
        <ImageButton
            android:id="@+id/img_chatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@android:drawable/stat_sys_phone_call"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@drawable/nav_item_color" />

    </LinearLayout>

</RelativeLayout>